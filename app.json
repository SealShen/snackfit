{
    "expo":  {
                 "name":  "SnackFit MVP",
                 "slug":  "snackfit-mvp",
                 "version":  "0.6.1",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "splash":  {
                                "image":  "./assets/splash.png",
                                "resizeMode":  "contain",
                                "backgroundColor":  "#0E0E10"
                            },
                 "assetBundlePatterns":  [
                                             "**/*"
                                         ],
                 "ios":  {
                             "supportsTablet":  true,
                             "infoPlist":  {
                                               "NSLocationWhenInUseUsageDescription":  "我們會使用您的位置來挑選適合的運動建議（例如室內/戶外、附近空間）。",
                                               "NSUserTrackingUsageDescription":  "僅用於改善建議體驗，不會用於廣告追蹤。"
                                           }
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/adaptive-icon.png",
                                                      "backgroundColor":  "#0E0E10"
                                                  }
                             },
                 "web":  {
                             "bundler":  "metro",
                             "favicon":  "./assets/favicon.png"
                         }
             }
}
